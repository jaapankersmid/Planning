# Caddy regelt de reverse proxy én de HTTPS-certificaten (via Let's Encrypt)
# volledig automatisch, gebaseerd op de waarde van DOMAIN in .env — dit
# bestand hoef je normaal niet aan te passen, alleen .env.
#
# - Nog geen domein? Zet DOMAIN=":80" in .env. Caddy herkent dat als "geen
#   hostnaam" en serveert dan gewoon platte HTTP op poort 80 — bereikbaar via
#   http://<server-ip>. Er wordt dan GEEN certificaat aangevraagd (dat kan
#   ook niet voor een kaal IP-adres). Log tijdens deze fase liever geen
#   "echte" wachtwoorden in — het wachtwoordverkeer is dan niet versleuteld.
# - Zodra het domein er is: zet DOMAIN="rooster.jouwbedrijf.nl" (of wat het
#   ook wordt) in .env, zorg dat het A-record naar dit server-IP wijst, en
#   herstart met `docker compose -f docker-compose.prod.yml up -d`. Caddy
#   ziet dan vanzelf dat het een echte hostnaam is en regelt HTTPS.

{$DOMAIN} {
	reverse_proxy app:3000
}

# ── Bréborgh prijstools: hub (intern) en aanvraagformulier (klanten) ─────────
# Statische bestanden uit de Hub-repository (/srv/hub/site op de server, in de
# caddy-container gemount op /srv/sign, zie docker-compose.prod.yml). Eén
# domein, twee paden:  /hub/  en  /aanvraag/.
# Het domein staat in .env als HUB_DOMAIN (bv. verhuur.breborgh.nl). Het
# A-record van dat domein moet naar dit server-IP wijzen (en een eventueel
# AAAA-record ook, of weg); Caddy regelt het HTTPS-certificaat vanzelf.
# Van domein wisselen = alleen HUB_DOMAIN in .env aanpassen en daarna
# `docker compose -f docker-compose.prod.yml up -d`; dit bestand blijft gelijk.
{$HUB_DOMAIN} {
	root * /srv/sign
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Prijzen en rekenregels: browser controleert bij elk bezoek of er een
	# nieuwere versie is (ETag), dus een prijswijziging is meteen zichtbaar.
	@core path /breborgh-core.js
	header @core Cache-Control "no-cache"

	# Het interne deel niet laten indexeren door zoekmachines.
	@hub path /hub /hub/*
	header @hub X-Robots-Tag "noindex, nofollow"

	# Hub als installeerbare app: de service worker moet altijd vers opgehaald
	# worden en het manifest heeft een eigen content-type.
	@hubsw path /hub/sw.js
	header @hubsw Cache-Control "no-cache"
	@hubmanifest path /hub/manifest.webmanifest
	header @hubmanifest Content-Type "application/manifest+json"

	# De kale hoofdpagina stuurt door naar het klantformulier.
	redir / /aanvraag/ 302

	file_server
}

# Wanneer het verhuurplatform later op dezelfde server bijkomt, voeg je er
# hier gewoon een tweede domein/subdomein-blok bij, bv.:
#
# verhuur.{$DOMAIN} {
# 	reverse_proxy verhuur-app:3000
# }
#
# en een bijbehorende "verhuur-app"-service in docker-compose.prod.yml.
