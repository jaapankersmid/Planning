// Rooster-app datamodel
// Ontworpen op basis van Planning V2.0.xlsx: medewerkers, diensttypen (shiftcodes) en
// dagelijkse dienst-toewijzingen.
//
// Inloggen gebeurt met zelf aangemaakte accounts (e-mail + wachtwoord, zie
// src/lib/password.ts en src/auth.ts) — geen Google-login. De Google-velden op
// User horen bij een aparte, losstaande koppeling: iemand kan ingelogd zijn
// met zijn eigen wachtwoord én daarnaast toestemming geven om diensten naar
// zijn eigen Google Calendar te laten pushen (zie src/app/api/google-calendar).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: de verbindings-URL staat niet meer in dit bestand maar in
  // prisma.config.ts (voor migraties/db push) en wordt bij het draaien van de
  // app via een driver-adapter meegegeven (zie src/lib/prisma.ts).
}

enum Role {
  ADMIN // leidinggevende / planner: mag rooster en stamgegevens bewerken
  EMPLOYEE // medewerker: ziet (in elk geval) het eigen rooster, kan agenda-sync aanzetten
}

model User {
  id    String  @id @default(cuid())
  name   String?
  email  String  @unique
  role   Role    @default(EMPLOYEE)
  // Een uitgezet account kan niet meer inloggen, maar blijft (met historie)
  // bestaan — voor iemand die tijdelijk geen toegang moet hebben.
  active Boolean @default(true)

  // Formaat "salt:hash" (scrypt, zie src/lib/password.ts) — nooit het
  // wachtwoord zelf, en geen externe login-provider nodig.
  passwordHash String
  // Moet deze gebruiker bij de eerstvolgende login een nieuw wachtwoord
  // kiezen? Staat aan na aanmaken/resetten door een leidinggevende.
  mustChangePassword Boolean @default(true)

  // Koppeling naar de "papieren" medewerker uit Personeelslijst. Eén medewerker kan
  // hooguit één account claimen; niet iedere medewerker hoeft ooit in te loggen.
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique

  // --- Google Calendar-koppeling (los van inloggen) ---------------------
  // Staat de gebruiker toe dat hun diensten automatisch naar hun Google
  // Calendar worden gepusht? Pas waar als er ook echt tokens zijn verkregen.
  calendarSyncEnabled Boolean @default(false)
  googleRefreshToken  String? @db.Text
  googleAccessToken   String? @db.Text
  googleTokenExpiresAt Int?
  // Id van de (aparte) Google-agenda "Werkrooster" die voor deze gebruiker is
  // aangemaakt, zodat diensten niet tussen hun privé-afspraken belanden.
  googleCalendarId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id         String  @id @default(cuid())
  // Oorspronkelijke ID uit Planning V2.0 (bv. "P001"), handig bij imports/exports.
  externalId String? @unique
  name       String
  // Kleurgroep zoals in de huidige Personeelslijst (Rood/Oranje/Geel/Groen/...).
  colorGroup String?
  active     Boolean @default(true)
  experience Float?

  user         User?
  assignments  ShiftAssignment[]
  weeklyEntries WeeklyScheduleEntry[]
  dayOverrides DayOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftType {
  id    String @id @default(cuid())
  // Korte code zoals in de legenda: O, A, X, CrO, UitO, ...
  code  String @unique
  label String
  // Kleur voor de roostercel, als hex-code (bv. "#2f6e63").
  color String

  // Eerste (of enige) tijdsblok van de dienst.
  startTime String?
  endTime   String?
  // Tweede tijdsblok, voor gesplitste diensten zoals "Uit" (ochtend + avond uitlaten).
  secondStartTime String?
  secondEndTime   String?

  // Telt deze dienst mee in het ochtend- resp. avond-uitlaatoverzicht op /bezetting?
  countsMorningWalk Boolean @default(false)
  countsEveningWalk Boolean @default(false)

  // Telt deze dienst mee in de bezetting bovenin het rooster: ochtend (8:00-12:30)
  // resp. middag (15:30-19:30)?
  countsMorning   Boolean @default(false)
  countsAfternoon Boolean @default(false)

  active        Boolean               @default(true)
  assignments   ShiftAssignment[]
  weeklyEntries WeeklyScheduleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftAssignment {
  id String @id @default(cuid())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  date DateTime @db.Date

  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id])
  shiftTypeId String

  note String?

  // MANUAL = handmatig ingesteld (of geimporteerd): heeft voorrang en wordt
  // nooit door het vaste rooster overschreven. TEMPLATE = automatisch uit het
  // vaste rooster aangemaakt en mag bij een wijziging van het vaste rooster mee.
  source ShiftSource @default(MANUAL)

  // Id van het bijbehorende Google Calendar-event, zodat een latere wijziging of
  // verwijdering het juiste event kan bijwerken i.p.v. dupliceren.
  googleEventId String?
  syncedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date, shiftTypeId])
  @@index([date])
}

enum ShiftSource {
  MANUAL
  TEMPLATE
}

// Kleurgroepen van medewerkers (Rood, Oranje, ...) met een instelbare volgorde.
model ColorGroup {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  // Telt deze groep mee in de bezetting bovenin het rooster? null = nog niet
  // ingesteld; dan gelden de standaardwaarden (Rood en Blauw tellen niet mee).
  countsInCoverage Boolean?
  // Geldt het vaste weekrooster voor deze groep? null = nog niet ingesteld; dan
  // gelden de standaardwaarden (alleen Rood en Oranje).
  usesTemplate Boolean?
}

// Het vaste weekrooster: per medewerker per weekdag (1 = maandag ... 7 = zondag)
// de standaarddienst.
model WeeklyScheduleEntry {
  id String @id @default(cuid())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  weekday Int

  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  shiftTypeId String

  @@unique([employeeId, weekday])
}

// Markeert dat een dag voor een medewerker handmatig is bepaald (ook als de
// dienst is leeggemaakt), zodat het vaste rooster daar afblijft.
model DayOverride {
  id String @id @default(cuid())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  date DateTime @db.Date

  @@unique([employeeId, date])
  @@index([date])
}

// Vakantieperiode met (optioneel) een wensaantal voor de bezetting. In het rooster
// kleurt de bezetting groen als dat aantal gehaald is en rood als het eronder blijft.
model HolidayPeriod {
  id String @id @default(cuid())

  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // Gewenst aantal mensen in de ochtend (8:00-12:30) resp. middag (15:30-19:30).
  wantMorning   Int?
  wantAfternoon Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}
